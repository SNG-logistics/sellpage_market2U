# Firebase web config — copy to .env.local and fill in from
# Firebase console → Project settings → Your apps → Web app.
#
# These are NOT secrets: a Firebase web config is shipped to every visitor in
# the client bundle by design. Access is controlled by firestore.rules and
# storage.rules, not by keeping these values hidden. Do not put an Admin SDK
# service-account key here — that one IS a secret and must stay server-side.
#
# Leave these unset to run in local mode: the app falls back to localStorage
# and the admin pages are unprotected (fine for development, never for a
# deployed site).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

rules_version = '2';

// Market2U sellpages.
//
// Threat model: the admin UI is a browser app, so nothing it does can be
// trusted. These rules are the real boundary.
//
// - Anyone may read a page that is actually published, and only the published
//   half of it is useful to them. Draft-only pages are not readable at all.
// - Only a signed-in admin (custom claim `admin: true`, set server-side with
//   the Admin SDK) may create, change or delete anything.
// - Version snapshots are admin-only in both directions; the public page never
//   needs them.
service cloud.firestore {
  match /databases/{database}/documents {

    // `.get('admin', false)` rather than `.admin`: a token without the claim
    // has no such property, and reading it raises an evaluation error instead
    // of returning false.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    function isPublished(page) {
      return page.status == 'published' && page.publishedConfig != null;
    }

    // Fields a client must never be able to forge or rewrite.
    function immutableIdentity(existing, incoming) {
      return incoming.id == existing.id;
    }

    match /sellpages/{pageId} {
      // Public read is limited to pages that are live. A draft is invisible
      // until it has been published at least once.
      allow get: if isAdmin() || isPublished(resource.data);

      // The public route looks a page up by slug, which Firestore evaluates as
      // a LIST, not a get — so an admin-only list would take the whole public
      // site down. Firestore allows a list only when the QUERY proves every
      // document it could return satisfies this rule, so the condition can
      // only mention fields the query constrains: `status`, and not
      // `isPublished`, whose `publishedConfig != null` half is unprovable from
      // a query. A page with status 'published' always has a publishedConfig
      // (publishPage writes them together) and getPublishedPageBySlug checks
      // it again before rendering. An unconstrained list is still refused.
      allow list: if isAdmin() || resource.data.status == 'published';

      allow create: if isAdmin()
                    && request.resource.data.id == pageId
                    && request.resource.data.schemaVersion is int;

      allow update: if isAdmin()
                    && immutableIdentity(resource.data, request.resource.data)
                    && request.resource.data.schemaVersion is int;

      allow delete: if isAdmin();

      match /versions/{versionId} {
        allow read, write: if isAdmin();
      }
    }

    // Anything not matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

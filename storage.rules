rules_version = '2';

// Media for sellpages (Phase 8 media library).
//
// Uploads are admin-only and constrained by type and size at the boundary —
// a client-side check on the upload form is a convenience, not a control.
service firebase.storage {
  match /b/{bucket}/o {

    // `.get('admin', false)` rather than `.admin`: a token without the claim
    // has no such property, and reading it raises an evaluation error instead
    // of returning false.
    function isAdmin() {
      return request.auth != null && request.auth.token.get('admin', false) == true;
    }

    function isImage() {
      return request.resource.contentType.matches('image/(png|jpeg|jpg|gif|webp|svg\\+xml)');
    }

    function withinSizeLimit() {
      return request.resource.size < 10 * 1024 * 1024; // 10 MB
    }

    // Published pages load these directly in the browser, so read is public.
    match /sellpages/{pageId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && withinSizeLimit();
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
